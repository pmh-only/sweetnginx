# syntax=docker/dockerfile:1.7

ARG OPENSSL_ECH_TAG=3.9.0-ech
ARG NGHTTP3_VERSION=1.9.0
ARG CURL_VERSION=8.13.0
ARG MAKE_JOBS=0

FROM alpine:3.21 AS openssl-builder

ARG OPENSSL_ECH_TAG
ARG MAKE_JOBS

RUN apk add --no-cache build-base perl linux-headers

RUN --mount=type=cache,target=/var/cache/distfiles \
    archive="/var/cache/distfiles/openssl-${OPENSSL_ECH_TAG}.tar.gz" && \
    tmp="${archive}.tmp" && \
    if [ ! -s "$archive" ]; then \
      if wget -nv -O "$tmp" \
          "https://github.com/defo-project/openssl/archive/refs/tags/${OPENSSL_ECH_TAG}.tar.gz"; then \
        mv "$tmp" "$archive"; \
      else \
        rm -f "$tmp" && \
        wget -nv -O "$tmp" \
          "https://github.com/defo-project/openssl/archive/refs/heads/${OPENSSL_ECH_TAG}.tar.gz" && \
        mv "$tmp" "$archive"; \
      fi; \
    fi && \
    mkdir -p /src/openssl && \
    tar xzf "$archive" --strip-components=1 -C /src/openssl

RUN --mount=type=cache,target=/root/.cache/ccache \
    jobs="${MAKE_JOBS}" && \
    if [ "$jobs" = "0" ]; then jobs="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)"; fi && \
    cd /src/openssl && \
    perl Configure \
      --prefix=/usr/local/openssl-ech \
      --openssldir=/usr/local/openssl-ech/ssl \
      no-tests shared enable-quic && \
    make -j"$jobs" && \
    make install_sw

FROM alpine:3.21 AS nghttp3-builder

ARG NGHTTP3_VERSION
ARG MAKE_JOBS

RUN apk add --no-cache build-base cmake

RUN --mount=type=cache,target=/var/cache/distfiles \
    archive="/var/cache/distfiles/nghttp3-${NGHTTP3_VERSION}.tar.gz" && \
    if [ ! -s "$archive" ]; then \
      wget -nv -O "${archive}.tmp" \
        "https://github.com/ngtcp2/nghttp3/releases/download/v${NGHTTP3_VERSION}/nghttp3-${NGHTTP3_VERSION}.tar.gz" && \
      mv "${archive}.tmp" "$archive"; \
    fi && \
    mkdir -p /src/nghttp3 && \
    tar xzf "$archive" --strip-components=1 -C /src/nghttp3

RUN jobs="${MAKE_JOBS}" && \
    if [ "$jobs" = "0" ]; then jobs="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)"; fi && \
    cd /src/nghttp3 && \
    cmake -B build \
      -DCMAKE_INSTALL_PREFIX=/usr/local/nghttp3 \
      -DCMAKE_BUILD_TYPE=Release \
      -DENABLE_SHARED_LIB=ON \
      -DENABLE_STATIC_LIB=OFF && \
    cmake --build build -j"$jobs" && \
    cmake --install build

FROM alpine:3.21 AS curl-builder

ARG CURL_VERSION
ARG MAKE_JOBS

COPY --from=openssl-builder /usr/local/openssl-ech /usr/local/openssl-ech
COPY --from=nghttp3-builder /usr/local/nghttp3 /usr/local/nghttp3

RUN apk add --no-cache build-base autoconf automake libtool pkgconf nghttp2-dev

RUN --mount=type=cache,target=/var/cache/distfiles \
    archive="/var/cache/distfiles/curl-${CURL_VERSION}.tar.gz" && \
    if [ ! -s "$archive" ]; then \
      wget -nv -O "${archive}.tmp" \
        "https://curl.se/download/curl-${CURL_VERSION}.tar.gz" && \
      mv "${archive}.tmp" "$archive"; \
    fi && \
    mkdir -p /src/curl && \
    tar xzf "$archive" --strip-components=1 -C /src/curl

ENV PKG_CONFIG_PATH=/usr/local/openssl-ech/lib64/pkgconfig:/usr/local/openssl-ech/lib/pkgconfig:/usr/local/nghttp3/lib/pkgconfig

RUN jobs="${MAKE_JOBS}" && \
    if [ "$jobs" = "0" ]; then jobs="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)"; fi && \
    cd /src/curl && \
    autoreconf -fi && \
    ./configure \
      --prefix=/usr/local/curl-ech \
      --with-openssl=/usr/local/openssl-ech \
      --with-openssl-quic \
      --with-nghttp3=/usr/local/nghttp3 \
      --enable-ech \
      --disable-ldap \
      --disable-ldaps \
      --without-brotli \
      --without-zstd \
      --without-libpsl && \
    make -j"$jobs" && \
    make install

FROM alpine:3.21

COPY --from=openssl-builder /usr/local/openssl-ech /usr/local/openssl-ech
COPY --from=nghttp3-builder /usr/local/nghttp3/lib /usr/local/nghttp3/lib
COPY --from=curl-builder    /usr/local/curl-ech    /usr/local/curl-ech

RUN apk add --no-cache ca-certificates libstdc++ nghttp2-libs && \
    ln -s /usr/local/curl-ech/bin/curl /usr/local/bin/curl

ENV LD_LIBRARY_PATH=/usr/local/openssl-ech/lib:/usr/local/openssl-ech/lib64:/usr/local/nghttp3/lib

ENTRYPOINT ["/usr/local/curl-ech/bin/curl"]
